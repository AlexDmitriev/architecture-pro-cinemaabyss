events {
    worker_connections 1024;
}

http {
    # Map для преобразования переменной окружения GRADUAL_MIGRATION в переменную nginx
    map "${GRADUAL_MIGRATION}" $use_gradual_migration {
        "true" 1;
        default 0;
    }

    upstream monolith_backend {
        server ${MONOLITH_HOST};
    }

    upstream movies_service_backend {
        server ${MOVIES_SERVICE_HOST};
    }

    upstream events_service_backend {
        server ${EVENTS_SERVICE_HOST};
    }

    # Split клиент для постепенной миграции - распределяет запросы между movies и monolith
    # Используем комбинацию переменных для более равномерного распределения
    # Добавляем http_user_agent, request_method и query_string для увеличения разнообразия хешей
    # ${MOVIES_MIGRATION_PERCENT}% запросов идут на movies-service, остальные на monolith
    # Если GRADUAL_MIGRATION=false, то MOVIES_MIGRATION_PERCENT должен быть установлен в 100
    split_clients "${remote_addr}${http_user_agent}${request_uri}${request_method}${args}${time_iso8601}" $movies_migration {
        ${MOVIES_MIGRATION_PERCENT}% ${MOVIES_SERVICE_URL};
        * ${MONOLITH_URL};
    }

    server {
        listen ${PORT};
        server_name localhost;

        # Логирование
        access_log /var/log/nginx/access.log;
        error_log /var/log/nginx/error.log;

        # Статические файлы (если нужны)
        location /static/ {
            alias /usr/share/nginx/html/static/;
        }

        # Проксирование на movies-service или monolith в зависимости от миграции
        location ~ ^/api/movies(/|$) {
            if ($arg_debug_migration) {
                add_header X-Migration-Target "movies_service_backend";
                proxy_pass ${MOVIES_SERVICE_URL};
                break;
            }
            
            # Используем результат split_clients напрямую
            # Если GRADUAL_MIGRATION=true и MOVIES_MIGRATION_PERCENT=50, то 50% на movies, 50% на monolith
            # Если GRADUAL_MIGRATION=false, то MOVIES_MIGRATION_PERCENT должен быть 100 (все на movies)
            
            # Добавляем заголовок для отладки - показывает, куда идет запрос
            add_header X-Migration-Target $movies_migration;
            
            proxy_pass $movies_migration;
            
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # Таймауты
            proxy_connect_timeout 30s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
        }

        # Проксирование на events-service
        location ~ ^/api/events(/|$) {
            proxy_pass ${EVENTS_SERVICE_URL};
            
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # Таймауты
            proxy_connect_timeout 30s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
        }

        # Все остальные запросы идут на монолит
        location / {
            proxy_pass ${MONOLITH_URL};
            
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # Таймауты
            proxy_connect_timeout 30s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
        }

        # Health check endpoint
        location /health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }
    }
}